{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        metosin/malli {:mvn/version "0.20.1"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        io.github.hive-agi/hive-addon {:mvn/version "1.0.15"}
        io.github.hive-agi/hive-spi {:mvn/version "1.4.1"}
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.33"}}

 :aliases
 {:dev {:extra-paths ["dev" "test" "test/resources"]
        :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}}}

  :test {:extra-paths ["test" "test/resources"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.clojure/test.check {:mvn/version "1.1.3"}}
         ;; :integration reaches the network (store.hive-mcp.com).
         :main-opts ["-m" "cognitect.test-runner" "-e" ":integration"]
         :exec-fn cognitect.test-runner.api/test}

  :integration {:extra-paths ["test" "test/resources"]
                :extra-deps {io.github.cognitect-labs/test-runner
                             {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                             org.clojure/test.check {:mvn/version "1.1.3"}}
                :main-opts ["-m" "cognitect.test-runner" "-i" ":integration"]}

  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.24"}}
          :jvm-opts ["-Xmx1g"]
          :ns-default hive-build.api}}}
